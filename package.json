{
  "name": "ferreteria-4-esquinas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API (Node + Express + PostgreSQL) para Ferreteria 4 Esquinas: catalogo, cotizaciones, cuentas de cliente, panel de administrador y sincronizacion con Alegra.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node db/migrate.js",
    "seed:products": "node db/seed-products.js",
    "seed:admin": "node db/seed-admin.js",
    "migrate:encrypt": "node db/migrate-encrypt.js",
    "migrate:apple": "node db/migrate-apple.js",
    "migrate:superadmin": "node db/migrate-superadmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.12.0"
  }
}
