# Copia este archivo a .env para desarrollo local (nunca subas el .env real a git).
# En Render, estas mismas variables se configuran en el panel del servicio (Environment).

# Cadena de conexion de tu base de datos Postgres (por ejemplo, de Neon).
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Clave secreta para firmar los tokens de sesion (JWT). Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Credenciales del administrador que crea el script db/seed-admin.js
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ferreteria4esquinas.com
ADMIN_PASSWORD=cambia-esto-por-una-clave-fuerte

# Credenciales de la API de Alegra (Configuracion > API en tu cuenta de Alegra).
# Si se dejan vacias, la sincronizacion con Alegra simplemente se omite.
ALEGRA_EMAIL=
ALEGRA_TOKEN=

# Llaves de Wompi (Configuracion > Desarrolladores en tu cuenta de Wompi).
# Usa las que empiezan con pub_test_/test_integrity_/test_events_ para pruebas en
# sandbox, y las pub_prod_/prod_integrity_/prod_events_ cuando ya sea produccion real.
# Si se dejan vacias, el sitio simplemente no ofrece la opcion de pagar en linea.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Dominio desde el que se permite llamar a esta API (tu sitio en GitHub Pages).
CORS_ORIGIN=https://richyproducer-sudo.github.io

PORT=10000
